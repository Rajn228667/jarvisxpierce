# Копируйте в .env перед docker compose up
# cp .env.example .env

# JWT — задайте сильный секрет (минимум 32 символа)
JWT_SECRET=change-me-to-a-strong-random-secret-at-least-32-chars

# Groq AI (опционально). Без ключа AI-модули работают на детерминированном fallback.
# Получить: https://console.groq.com/keys
GROQ_API_KEY=
